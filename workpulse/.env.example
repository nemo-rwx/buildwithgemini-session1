# Local development configuration
# For deployment, these are set via Terraform / Secret Manager / deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-03-9b8a9428b63e
GOOGLE_CLOUD_LOCATION=global

# OAuth 2.0 Credentials (Email, Slack, Teams, Jira)
# In production, these are read automatically from Google Cloud Secret Manager.
SLACK_OAUTH_TOKEN=xoxb-your-slack-bot-user-oauth-token
JIRA_OAUTH_TOKEN=your-jira-atlassian-oauth2-bearer-token
TEAMS_OAUTH_TOKEN=your-microsoft-teams-graph-oauth2-token
EMAIL_OAUTH_TOKEN=your-gmail-or-outlook-oauth2-token

JIRA_OAUTH_CLIENT_ID=your-jira-client-id
JIRA_OAUTH_CLIENT_SECRET=your-jira-client-secret
TEAMS_OAUTH_TENANT_ID=your-azure-tenant-id
TEAMS_OAUTH_CLIENT_ID=your-azure-client-id
TEAMS_OAUTH_CLIENT_SECRET=your-azure-client-secret
GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
